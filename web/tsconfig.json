{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@panel/*": [
        "panel/src/*"
      ]
    },
    "types": [
      "element-plus/global",
      "node"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "preserve"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "panel/src/**/*.ts",
    "panel/src/**/*.vue",
    "vite.config.ts",
    "auto-imports.d.ts"
  ]
}
