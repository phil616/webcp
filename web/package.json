{
  "name": "webcp-web",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run type-check && vite build --mode production",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src tests vite.config.ts playwright.config.ts",
    "serve": "vite --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit",
    "build:dev": "vite build --mode development",
    "build:pro": "npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e:dev": "RESTY_TEST_MODE=dev playwright test"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@element-plus/icons-vue": "^2.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "anser": "^2.3.5",
    "axios": "^1.21.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "element-plus": "2.14.7",
    "js-base64": "^3.9.6",
    "mitt": "^3.0.1",
    "path-browserify": "^1.0.1",
    "pinia": "^4.1.0",
    "screenfull": "^6.0.2",
    "tailwindcss": "^4.3.5",
    "unplugin-auto-import": "^21.1.0",
    "uuid": "^14.0.3",
    "vue": "^3.5.0",
    "vue-clipboard3": "^2.0.0",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "prettier": "^3.9.10",
    "sass": "^1.108.2",
    "typescript": "^5.9.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.0.0",
    "vite-svg-loader": "^5.1.3",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
